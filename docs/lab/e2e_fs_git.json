{
  "merged_suite_name": "lab",
  "suites": [
    {
      "name": "fs",
      "kind": "mcp",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp/pauth-lab-fs"
      ],
      "signer": "fs-mcp",
      "operand_policy": {
        "search_files": [
          "pattern",
          "excludePatterns"
        ],
        "directory_tree": [
          "excludePatterns"
        ],
        "read_text_file": [
          "head",
          "tail"
        ],
        "read_file": [
          "head",
          "tail"
        ]
      },
      "verification_reads": [
        "list_directory",
        "list_directory_with_sizes",
        "directory_tree",
        "get_file_info",
        "search_files",
        "list_allowed_directories",
        "read_text_file",
        "read_file",
        "read_multiple_files"
      ]
    },
    {
      "name": "git",
      "kind": "mcp",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "/tmp/pauth-lab-git"
      ],
      "signer": "git-mcp",
      "operand_policy": {
        "git_diff_unstaged": [
          "context_lines"
        ],
        "git_diff_staged": [
          "context_lines"
        ],
        "git_diff": [
          "context_lines"
        ],
        "git_log": [
          "max_count",
          "start_timestamp",
          "end_timestamp"
        ]
      },
      "verification_reads": [
        "git_status",
        "git_log",
        "git_diff_unstaged",
        "git_diff_staged",
        "git_branch",
        "git_show"
      ]
    }
  ],
  "source_trust": {
    "mode": "fail_closed",
    "trusted_tools": []
  }
}

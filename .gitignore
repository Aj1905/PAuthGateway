# .gitignore — 3 節構成 (再現可能 / 秘密情報 / 端末固有) + 4 (この repo には載せない)。
# ここに書いたものは端末間で同期されない。
# 大きいファイルは除外しない。data/ に置き、必要になった時点で `git lfs track "data/**"` で追跡する。

# ---- 1. 再現可能: コマンドで作り直せるもの。再現手順は README に書く ----
.venv/
__pycache__/
*.pyc

# experiment caches (large, regenerable)
tests/experiment/cache/
tests/experiment/results/*
!tests/experiment/results/agentdojo_factorial_gpt41_t0_single_20260803.jsonl
!tests/experiment/results/agentdojo_factorial_gpt41_t0_single_20260803.summary.json
!tests/experiment/results/agentdojo_factorial_gpt41_t0_single_20260803.analysis.json
!tests/experiment/results/agentdojo_factorial_gpt41_t0_single_20260803.manifest.json
!tests/experiment/results/agentdojo_factorial_gpt41_t0_single_20260803_report.md
!tests/experiment/results/agentdojo_reference_trace_g1_g2_20260803.json
!tests/experiment/results/pauth_core_fpfn_gpt41_cached_20260803.json
gateway/cache/

# real-user prompt corpus extracted from local Claude Code transcripts
# (regenerable via tests/fixtures/extract_real_prompts.py)
tests/fixtures/real_external_prompts.jsonl

# graphify tool output — generated caches/reports, regenerable
graphify-out/

# local scratch — 使い捨ての作業領域
tmp/
tests/experiment/regen_scratch/
tests/experiment/g5_scratch/
tests/experiment/tau_scratch/
tests/experiment/bestofn_scratch/
tests/experiment/funnel_scratch/

# LaTeX build artifacts
paper/PAuthGateway/build/
paper/**/*.aux
paper/**/*.log
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.bbl
paper/**/*.blg
paper/**/*.synctex.gz

# ---- 2. 秘密情報: git に入れない。値は 1Password に置き、参照だけ .env.tpl に書く ----
.env
.env.*
!.env.tpl
!.env.example
!.env.*.example
me.env

# ---- 3. 端末固有: OS・エディタが作る付随ファイル ----
.DS_Store

# ---- 4. この repo には載せない: 別に正本があるか、公開しないもの ----
#      ここにあるものはこの端末にしか無い。端末を替えると引き継げない。
#      引き継ぎたいものは私的な別 repo に移すこと (特に paper/PAuthGateway/ と docs/*.md)。

# not part of the OSS library — kept local, untracked
slides/
*.pdf
vercel.json
.vercelignore

# exception: decks under docs/slides/ deploy to GitHub Pages, so each deck's
# index.html and img/ are tracked (scripts, hosting/, site/, .vercel stay local)
!docs/slides/
docs/slides/*
!docs/slides/*/
docs/slides/*/*
!docs/slides/*/index.html
!docs/slides/*/img/

# thesis manuscript — kept local, not published
paper/PAuthGateway/

# internal Japanese working logs — kept local, not published
docs/plan.md
docs/solution.md

# personal agent/advisory prefs — not project contributor guidance
AGENTS.md

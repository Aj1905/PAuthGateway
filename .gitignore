.venv/
__pycache__/
*.pyc
.env
me.env
.DS_Store

# experiment caches (large, regenerable)
tests/experiment/cache/
tests/experiment/results/
gateway/cache/

# real-user prompt corpus extracted from local Claude Code transcripts
# (regenerable via tests/fixtures/extract_real_prompts.py)
tests/fixtures/real_external_prompts.jsonl

# business strategy memo — kept local, not pushed to remote
docs/BUSINESS.md

# not part of the OSS library — kept local, untracked
slides/
*.pdf
vercel.json
.vercelignore

# exception: decks under docs/slides/ deploy to GitHub Pages, so each deck's
# index.html and img/ are tracked (scripts, hosting/, site/, .vercel stay local)
!docs/slides/
docs/slides/*
!docs/slides/*/
docs/slides/*/*
!docs/slides/*/index.html
!docs/slides/*/img/

# graphify tool output — generated caches/reports, regenerable
graphify-out/

# LaTeX build artifacts
paper/**/*.aux
paper/**/*.log
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.bbl
paper/**/*.blg
paper/**/*.synctex.gz

# internal Japanese working logs — kept local, not published
docs/plan.md
docs/solution.md

# personal agent/advisory prefs — not project contributor guidance
AGENTS.md
tests/experiment/regen_scratch/
tests/experiment/g5_scratch/
tests/experiment/tau_scratch/
tests/experiment/bestofn_scratch/
tests/experiment/funnel_scratch/
